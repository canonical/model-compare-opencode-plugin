{
  "name": "model-compare-opencode-plugin",
  "version": "0.2.0",
  "description": "OpenCode plugin that switches OpenRouter model aliases to the best value-for-money pick from canonical/model-compare's ranking (balanced, price, quality).",
  "keywords": [
    "opencode",
    "openrouter",
    "model-compare",
    "plugin",
    "llm"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "dist/tui.js",
    "vendor/model_compare.py",
    "vendor/UPSTREAM.json",
    "LICENSE",
    "README.md"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonical/model-compare-opencode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/canonical/model-compare-opencode-plugin/issues"
  },
  "homepage": "https://github.com/canonical/model-compare-opencode-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "seroval": "^1.6.9"
  },
  "scripts": {
    "build": "node scripts/build-tui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test && node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.16"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/solid": "^0.5.8",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "^22.18.13",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
